<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#24344B" />
            <stroke android:width="2dp" android:color="#FBBF24" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A2C46" />
            <stroke android:width="1dp" android:color="#D4AF37" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E1729" />
            <stroke android:width="1dp" android:color="#22304A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
