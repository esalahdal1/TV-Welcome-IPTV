<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_gradient"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="680dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_tv_card"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إعداد شاشة مَقَام — مساكن النزهة (MAQAM TV)"
                android:textColor="#E5C158"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="اختر نوع الشاشة وأدخل رقم الغرفة ورابط البث الداخلي إن وجد"
                android:textColor="#94A3B8"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="وضع تشغيل الشاشة:"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/mode_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/mode_room_radio"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tv_input"
                    android:buttonTint="#FBBF24"
                    android:checked="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="غرفة نزيل (?room=)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/mode_lobby_radio"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tv_input"
                    android:buttonTint="#FBBF24"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="صالة / ممر (?mode=lobby)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/room_input_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="رقم الغرفة:"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/room_number_input"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_tv_input"
                    android:focusable="true"
                    android:hint="مثال: 101"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textAlignment="viewStart"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="17sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="عنوان السيرفر المحلي (افتراضي تلقائي):"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/portal_url_input"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tv_input"
                    android:focusable="true"
                    android:hint="http://192.168.1.50/"
                    android:imeOptions="actionNext"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textDirection="ltr"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/discover_server_button"
                    android:layout_width="148dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tv_button"
                    android:focusable="true"
                    android:text="بحث تلقائي"
                    android:textAllCaps="false"
                    android:textColor="#FBBF24"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="رابط قائمة قنوات IPTV (اختياري):"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/m3u_url_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tv_input"
                android:focusable="true"
                android:hint="http://192.168.x.x/channels.m3u (اتركه فارغاً للافتراضي)"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textDirection="ltr"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/save_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.3"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_tv_button"
                    android:focusable="true"
                    android:text="حفظ وتشغيل الشاشة"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/overlay_perm_button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tv_button"
                    android:focusable="true"
                    android:text="صلاحية الظهور (اختياري)"
                    android:textAllCaps="false"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</ScrollView>
